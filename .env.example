# App
APP_NAME=go-clean-template
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
# Logger
LOG_LEVEL=debug
# PG
POSTGRES_SSL_MODE=disable
POSTGRES_HOST=postgres_finnhub
POSTGRES_PORT=5432
POSTGRES_DB=postgres_db
POSTGRES_PASSWORD=myAwEsOm3pa55@w0rd
POSTGRES_USER=postgres_user
PG_POOL_MAX=2
PG_URL=postgres://user:myAwEsOm3pa55@w0rd@postgres_finnhub:5432/db
# TIMESCALE
TIMESCALE_SSL_MODE=disable
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=timescale_db
TIMESCALE_PASSWORD=myAwEsOm3pa55@w0rd
TIMESCALE_USER=timescale_user
TIMESCALE_POOL_MAX=2
TIMESCALE_URL=postgres://user:myAwEsOm3pa55@w0rd@timescaledb:5432/db
# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# gRPC
GRPC_PORT=8081
# RMQ
RMQ_RPC_SERVER=rpc_server
RMQ_RPC_CLIENT=rpc_client
RMQ_URL=amqp://guest:guest@rabbitmq:5672/
# NATS
NATS_RPC_SERVER=rpc_server
NATS_URL=nats://guest:guest@nats:4222/
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=true
# JWT
JWT_SECRET=your_super_secret_key_here